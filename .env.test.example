# Test-only environment overrides (copy to .env.test locally; never commit real secrets)
NODE_ENV=test

# Dedicated integration/e2e database — must end with _test and must NOT be catechism_api
DB_NAME=catechism_api_test

# Host-side MSSQL via Docker Compose publish port (WSL Docker on Windows)
DB_HOST=localhost
DB_PORT=14330

# Reuse credentials from .env for local development; override here only when needed
DB_USER=sa
DB_PASSWORD=ChangeMe_LocalDev123!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

SWAGGER_ENABLED=false

# Test-only JWT access secret (minimum 32 characters; never use in production)
JWT_ACCESS_SECRET=test-only-jwt-access-secret-32chars-minimum-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_HASH_SECRET=test-only-refresh-hash-secret-32chars-minimum-value
JWT_REFRESH_EXPIRES_IN=7d

# High limits for deterministic integration/e2e runs
AUTH_LOGIN_THROTTLE_LIMIT=1000
AUTH_LOGIN_THROTTLE_TTL_MS=60000
AUTH_REFRESH_THROTTLE_LIMIT=1000
AUTH_REFRESH_THROTTLE_TTL_MS=60000
