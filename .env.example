# Application environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on (also used for host publish mapping in Docker Compose)
PORT=3000

# Enable Swagger UI at /api/docs (defaults to true in development, false otherwise)
SWAGGER_ENABLED=true

# MSSQL connection
# - Host-side tools and npm CLI: DB_HOST=localhost; DB_PORT=1433 with MSSQL_PUBLISH_PORT=14330 resolves to the published Docker port automatically
# - Docker Compose overrides DB_HOST to the `mssql` service name for the API container
DB_HOST=localhost
DB_PORT=1433
DB_NAME=catechism_api
DB_USER=sa
# Local placeholder only — must meet SQL Server password complexity (8+ chars, mixed case, number, symbol)
DB_PASSWORD=ChangeMe_LocalDev123!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Host port published for MSSQL (avoids conflict with native Windows SQL Server on 1433)
MSSQL_PUBLISH_PORT=14330

# JWT access token (HS256) — replace with a strong random secret in real environments
JWT_ACCESS_SECRET=local-development-jwt-access-secret-32chars-min
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token HMAC secret (separate from access JWT secret)
JWT_REFRESH_HASH_SECRET=local-development-refresh-hash-secret-32chars-min
JWT_REFRESH_EXPIRES_IN=7d

# Auth endpoint rate limits (per client IP within TTL window)
AUTH_LOGIN_THROTTLE_LIMIT=10
AUTH_LOGIN_THROTTLE_TTL_MS=60000
AUTH_REFRESH_THROTTLE_LIMIT=20
AUTH_REFRESH_THROTTLE_TTL_MS=60000
