{
  "name": "catechism-api",
  "version": "0.0.1",
  "description": "Parish catechism platform backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "22.23.1",
    "npm": ">=10"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db:prepare": "ts-node --project tsconfig.json test/database/prepare-test-database.ts",
    "test:db:migrations": "ts-node --project tsconfig.json test/database/validate-test-database-migrations.ts",
    "test:integration": "npm run test:db:prepare && jest --config ./test/jest-integration.json --runInBand",
    "test:e2e:db": "npm run test:db:prepare && npm run test:db:migrations && jest --config ./test/jest-db-e2e.json --runInBand --forceExit",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "quality:full": "npm run quality && npm run test:db:migrations && npm run test:integration && npm run test:db:prepare -- --reset && npm run test:db:migrations && npm run test:e2e:db",
    "ci:wait-for-mssql": "ts-node --project tsconfig.json scripts/wait-for-mssql.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/database/migrations/",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "seed:auth-rbac": "ts-node --project tsconfig.json scripts/seed-auth-rbac.ts",
    "seed:parish-academic": "ts-node --project tsconfig.json scripts/seed-parish-academic.ts",
    "seed:class-enrollment": "ts-node --project tsconfig.json scripts/seed-class-enrollment.ts",
    "seed:curriculum-demo": "ts-node --project tsconfig.json scripts/seed-curriculum-demo.ts",
    "seed:question-bank-demo": "ts-node --project tsconfig.json scripts/seed-question-bank-demo.ts",
    "seed:learning-progress-demo": "ts-node --project tsconfig.json scripts/seed-learning-progress-demo.ts",
    "localization:process-jobs": "ts-node --project tsconfig.json scripts/localization-process-jobs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "joi": "^17.13.3",
    "mssql": "^11.0.1",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs/jwt)/)"
    ],
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ]
  }
}
