    {
      "name": "02 Catechist session lifecycle",
      "item": [
        {
          "name": "Resolve classId from catechist classes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 classes', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.items).to.be.an('array').that.is.not.empty;",
                  "pm.collectionVariables.set('classId', body.items[0].classId || body.items[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{catechistToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/me/catechist/classes?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["me", "catechist", "classes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List class sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 list', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.items).to.be.an('array');",
                  "pm.expect(body).to.have.property('page');",
                  "const scheduled = body.items.find(i => i.status === 'SCHEDULED' && i.title === 'co-demo-scheduled-upcoming');",
                  "if (scheduled) { pm.collectionVariables.set('scheduledSessionId', scheduled.id); }",
                  "const completed = body.items.find(i => i.status === 'COMPLETED');",
                  "if (completed) { pm.collectionVariables.set('sessionId', completed.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{catechistToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/classes/{{classId}}/sessions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["classes", "{{classId}}", "sessions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Create session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 create', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body).to.have.property('id');",
                  "pm.expect(body.status).to.eql('SCHEDULED');",
                  "pm.collectionVariables.set('sessionId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{catechistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"postman-manual-session\",\n  \"startsAt\": \"2026-12-12T02:00:00.000Z\",\n  \"endsAt\": \"2026-12-12T03:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/classes/{{classId}}/sessions"
          }
        },
        {
          "name": "Get session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 detail', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body).to.include.keys('id', 'classId', 'status', 'rosterCount', 'markedCount', 'unmarkedCount');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{catechistToken}}" }],
            "url": "{{baseUrl}}/class-sessions/{{sessionId}}"
          }
        },
        {
          "name": "Get session attendance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 attendance', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.items).to.be.an('array').that.is.not.empty;",
                  "pm.collectionVariables.set('enrollmentId', body.items[0].enrollmentId);",
                  "if (body.items.length > 1) { pm.collectionVariables.set('foreignEnrollmentId', body.items[1].enrollmentId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{catechistToken}}" }],
            "url": "{{baseUrl}}/class-sessions/{{sessionId}}/attendance"
          }
        },
        {
          "name": "Bulk mark attendance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 bulk put', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.markedCount).to.be.at.least(1);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{catechistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"enrollmentId\": \"{{enrollmentId}}\",\n      \"status\": \"PRESENT\",\n      \"note\": \"postman mark\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/class-sessions/{{sessionId}}/attendance"
          }
        },
        {
          "name": "Update session title",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 patch', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.title).to.eql('postman-manual-session-patched');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{catechistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"postman-manual-session-patched\"\n}"
            },
            "url": "{{baseUrl}}/class-sessions/{{sessionId}}"
          }
        },
        {
          "name": "Complete session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 complete', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql('COMPLETED');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{catechistToken}}" }],
            "url": "{{baseUrl}}/class-sessions/{{sessionId}}/complete"
          }
        }
      ]
    },
