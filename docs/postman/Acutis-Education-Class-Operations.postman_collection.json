              "listen": "test",
              "script": {
                "exec": ["pm.test('409', () => pm.response.to.have.status(409));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{catechistToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [{ \"enrollmentId\": \"{{enrollmentId}}\", \"status\": \"ABSENT\" }]\n}"
            },
            "url": "{{baseUrl}}/class-sessions/{{sessionId}}/attendance"
          }
        }
      ]
    }
  ]
