{
  "info": {
    "_postman_id": "acutis-education-class-operations-collection",
    "name": "Acutis Education — Class Operations",
    "description": "Manual verification for Class Operations (sessions + attendance) APIs.\n\nPrerequisites:\n1. npm run migration:run\n2. npm run seed:class-operations-demo\n3. npm run start:dev\n\nDemo actors (password {{demoPassword}}):\n- catechist@local.catechism.test\n- parent@local.catechism.test\n- student-alpha@local.catechism.test\n- admin@local.catechism.test (ParishAdmin)\n\nNever commit live JWTs or production secrets.\n\nRuntime validation of this collection is deferred to FE Integration / Stabilization Phase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "demoPassword", "value": "LocalDev!Sample2026" },
    { "key": "catechistEmail", "value": "catechist@local.catechism.test" },
    { "key": "parentEmail", "value": "parent@local.catechism.test" },
    { "key": "studentEmail", "value": "student-alpha@local.catechism.test" },
    { "key": "adminEmail", "value": "admin@local.catechism.test" },
    { "key": "catechistToken", "value": "" },
    { "key": "parentToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "classId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "scheduledSessionId", "value": "" },
    { "key": "enrollmentId", "value": "" },
    { "key": "foreignEnrollmentId", "value": "" },
    { "key": "unknownEnrollmentId", "value": "99999999-9999-4999-8999-999999999999" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Catechist login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 login', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('accessToken present', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('catechistToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{catechistEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Parent login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 login', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('parentToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{parentEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Student login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 login', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('studentToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
