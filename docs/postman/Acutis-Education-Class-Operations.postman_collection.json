          }
        },
        {
          "name": "ParishAdmin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 login', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
