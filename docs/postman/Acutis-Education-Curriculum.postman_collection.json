{
  "info": {
    "_postman_id": "acutis-education-curriculum-collection",
    "name": "Acutis Education — Curriculum",
    "description": "Local manual flow for curriculum admin + learner delivery. Run seeds first: auth-rbac → parish-academic → class-enrollment → curriculum-demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login catechist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{catechistEmail}}\",\n  \"password\": \"{{catechistPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login parent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{parentEmail}}\",\n  \"password\": \"{{parentPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "02 Admin — Curriculum lifecycle",
      "item": [
        {
          "name": "List parishes (resolve demo parishId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const parish = (body.items || []).find((p) => p.code === 'demo-parish');",
                  "if (parish) pm.environment.set('parishId', parish.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/parishes?search=demo-parish&limit=5"
          }
        },
        {
          "name": "List parish curricula",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/parishes/{{parishId}}/curricula?limit=20"
          }
        },
        {
          "name": "Create curriculum",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('curriculumId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"catechismLevelId\": \"{{catechismLevelId}}\",\n  \"code\": \"demo-curriculum-level-1\",\n  \"name\": \"Giáo trình Demo Cấp 1\",\n  \"description\": \"Synthetic demo curriculum\",\n  \"sourceLocale\": \"vi-VN\"\n}"
            },
            "url": "{{baseUrl}}/parishes/{{parishId}}/curricula"
          }
        },
        {
          "name": "Create draft version",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('versionId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"2026-2027 v1 (Demo)\"\n}"
            },
            "url": "{{baseUrl}}/curricula/{{curriculumId}}/versions"
          }
        },
        {
          "name": "Create topic",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('topicId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"demo-topic-creation\",\n  \"title\": \"Chúa Sáng Tạo\",\n  \"description\": \"Chủ đề mẫu\",\n  \"sortOrder\": 1\n}"
            },
            "url": "{{baseUrl}}/curriculum-versions/{{versionId}}/topics"
          }
        },
        {
          "name": "Create lesson",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('lessonId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"demo-lesson-creation-1\",\n  \"title\": \"Thế Giới Do Chúa Tạo Dựng\",\n  \"summary\": \"Bài học mẫu\",\n  \"sortOrder\": 1\n}"
            },
            "url": "{{baseUrl}}/topics/{{topicId}}/lessons"
          }
        },
        {
          "name": "Upsert lesson content (draft)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": {\n    \"schemaVersion\": 1,\n    \"blocks\": [\n      { \"type\": \"heading\", \"level\": 1, \"text\": \"Thế Giới Do Chúa Tạo Dựng\" },\n      { \"type\": \"paragraph\", \"text\": \"Nội dung mẫu tổng hợp cho môi trường phát triển.\" },\n      { \"type\": \"scripture_ref\", \"reference\": \"St 1,31\", \"text\": \"Thiên Chúa thấy mọi sự Người đã tạo ra đều tốt đẹp.\" }\n    ]\n  }\n}"
            },
            "url": "{{baseUrl}}/lessons/{{lessonId}}/content"
          }
        },
        {
          "name": "Publish version",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/curriculum-versions/{{versionId}}/publish"
          }
        },
        {
          "name": "Upsert curriculum assignment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"curriculumVersionId\": \"{{versionId}}\"\n}"
            },
            "url": "{{baseUrl}}/parishes/{{parishId}}/academic-years/{{academicYearId}}/catechism-levels/{{catechismLevelId}}/curriculum-assignment"
          }
        },
        {
          "name": "Get version tree (admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/curriculum-versions/{{versionId}}/tree"
          }
        },
        {
          "name": "Clone published to draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.environment.set('versionId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/curriculum-versions/{{versionId}}/clone-to-draft"
          }
        },
        {
          "name": "Verify published immutability (expect 409/422 on lesson update)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail on published lesson\"\n}"
            },
            "url": "{{baseUrl}}/lessons/{{lessonId}}"
          }
        }
      ]
    },
    {
      "name": "03 Learner delivery",
      "item": [
        {
          "name": "Resolve demo classId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const cls = (body.items || []).find((c) => c.code === 'demo-class-a');",
                  "if (cls) {",
                  "  pm.environment.set('classId', cls.id);",
                  "  pm.environment.set('academicYearId', cls.academicYearId);",
                  "  pm.environment.set('catechismLevelId', cls.catechismLevelId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/parishes/{{parishId}}/classes?search=demo-class-a&limit=5"
          }
        },
        {
          "name": "Class curriculum tree (catechist scoped)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/classes/{{classId}}/curriculum-tree"
          }
        },
        {
          "name": "Class lesson content (catechist scoped)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "vi-VN" }],
            "url": "{{baseUrl}}/classes/{{classId}}/lessons/{{lessonId}}/content"
          }
        },
        {
          "name": "Enrollment curriculum tree (parent scoped)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/enrollments/{{enrollmentId}}/curriculum-tree"
          }
        },
        {
          "name": "Enrollment lesson content (parent scoped)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "vi-VN" }],
            "url": "{{baseUrl}}/enrollments/{{enrollmentId}}/lessons/{{lessonId}}/content"
          }
        }
      ]
    }
  ]
}
