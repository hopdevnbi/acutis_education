      "name": "02 Bootstrap Context",
      "item": [
        {
          "name": "Parent discover children",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.children && body.children.length > 0) {",
                  "  const child = body.children[0];",
                  "  pm.collectionVariables.set('studentId', child.id);",
                  "  if (child.activeEnrollments && child.activeEnrollments.length > 0) {",
                  "    pm.collectionVariables.set('enrollmentId', child.activeEnrollments[0].id);",
                  "    pm.collectionVariables.set('classId', child.activeEnrollments[0].classId);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{parentToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/me/parent/children"
          }
        }
      ]
    },
    {
      "name": "03 Learner Flows",
      "item": [
        {
          "name": "Learner gamification summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 summary', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('pointsBalance is number', () => pm.expect(body.pointsBalance).to.be.a('number'));",
                  "pm.test('lifetimePositivePoints is number', () => pm.expect(body.lifetimePositivePoints).to.be.a('number'));",
                  "pm.test('activeBadgeCount >= 0', () => pm.expect(body.activeBadgeCount).to.be.at.least(0));",
                  "pm.test('activeMissionCount >= 0', () => pm.expect(body.activeMissionCount).to.be.at.least(0));",
                  "pm.test('completedMissionCount >= 0', () => pm.expect(body.completedMissionCount).to.be.at.least(0));",
                  "pm.test('latestAchievement exists or null', () => pm.expect(body).to.have.property('latestAchievement'));",
                  "pm.test('no staffNote leaked', () => pm.expect(body.staffNote).to.be.undefined);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/me/learner/gamification/summary"
          }
        },
        {
          "name": "Learner faith journey",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 faith-journey', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('summary object present', () => pm.expect(body.summary).to.be.an('object'));",
                  "pm.test('activeMissions array present', () => pm.expect(body.activeMissions).to.be.an('array'));",
                  "pm.test('recentBadges array present', () => pm.expect(body.recentBadges).to.be.an('array'));",
                  "pm.test('milestones array present', () => pm.expect(body.milestones).to.be.an('array'));",
                  "pm.test('recentTimeline array present', () => pm.expect(body.recentTimeline).to.be.an('array'));",
                  "pm.test('timeline capped at <= 20', () => pm.expect(body.recentTimeline.length).to.be.at.most(20));",
                  "pm.test('no staffNote in timeline', () => {",
                  "  body.recentTimeline.forEach(item => pm.expect(item.staffNote).to.be.undefined);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
